{"version": 2, "name": "arikashow", "builds": [{"src": "**/*", "use": "@vercel/static"}], "routes": [{"src": "/(.*)", "dest": "/$1"}], "headers": [{"source": "/asset/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/Js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/(.*)\\.html", "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]}]}