{"version": 2, "name": "arikashow", "builds": [{"src": "**/*", "use": "@vercel/static"}], "routes": [{"src": "/(.*)", "dest": "/$1"}], "headers": [{"source": "/asset/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}, {"key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable, s-maxage=31536000"}, {"key": "Vercel-CDN-Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/Js/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}, {"key": "CDN-Cache-Control", "value": "public, max-age=31536000, immutable, s-maxage=31536000"}, {"key": "Vercel-CDN-Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp|avif))$", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/(.*\\.(mp3|mp4|webm|ogg|wav))$", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/(.*\\.(glb|gltf|obj|fbx))$", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/(.*\\.(json|woff|woff2|ttf|otf|eot))$", "headers": [{"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}]}, {"source": "/(.*)\\.html", "headers": [{"key": "Cache-Control", "value": "no-cache, no-store, must-revalidate"}, {"key": "Pragma", "value": "no-cache"}, {"key": "Expires", "value": "0"}]}]}